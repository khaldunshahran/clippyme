# Copy to .env.local and fill in real values (never commit real values).
# Backend API base (production). Leave empty for same-origin/dev proxy.
VITE_API_URL=https://nugget-api.tellagbe.com

# Supabase Auth (frontend login). PUBLISHABLE key only — it is public by design
# and safe to ship in the bundle. NEVER put a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
