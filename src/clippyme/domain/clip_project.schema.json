{
  "$defs": {
    "AudioTrack": {
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "music file; null = no music (v1)",
          "title": "File"
        },
        "volume": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Volume",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Offset",
          "type": "number"
        }
      },
      "title": "AudioTrack",
      "type": "object"
    },
    "CaptionWord": {
      "properties": {
        "id": {
          "default": "",
          "description": "stable word ID, e.g. 'w12'",
          "title": "Id",
          "type": "string"
        },
        "w": {
          "title": "W",
          "type": "string"
        },
        "start": {
          "description": "source seconds",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "description": "source seconds",
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "removed": {
          "default": false,
          "description": "word carved out of the timeline; kept with its ID for strikethrough/restore (ID-keyed data like colors/emoji survives)",
          "title": "Removed",
          "type": "boolean"
        }
      },
      "required": [
        "w",
        "start",
        "end"
      ],
      "title": "CaptionWord",
      "type": "object"
    },
    "Captions": {
      "properties": {
        "style": {
          "default": "hormozi",
          "title": "Style",
          "type": "string"
        },
        "position": {
          "default": "lower-third",
          "title": "Position",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/CaptionWord"
          },
          "title": "Words",
          "type": "array"
        },
        "edits": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "word ID (or legacy word-index as string) -> corrected text",
          "title": "Edits",
          "type": "object"
        },
        "next_word_id": {
          "default": 0,
          "description": "persisted counter; fresh word IDs are f'w{next_word_id}', then it increments",
          "minimum": 0,
          "title": "Next Word Id",
          "type": "integer"
        }
      },
      "title": "Captions",
      "type": "object"
    },
    "CropBox": {
      "description": "9:16 crop window inside the 16:9 source slice (source pixel coords).",
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "CropBox",
      "type": "object"
    },
    "FramingKeyframe": {
      "description": "One crop target in clip-relative inclusive frame coordinates.",
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "x2": {
          "minimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y2": {
          "minimum": 0,
          "title": "Y2",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "lock",
            "ease"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "x1",
        "y1",
        "x2",
        "y2",
        "kind"
      ],
      "title": "FramingKeyframe",
      "type": "object"
    },
    "FramingPlanIdentity": {
      "description": "Immutable identity of the promoted stable sidecar + Task 12 plan.",
      "properties": {
        "plan_ref": {
          "title": "Plan Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "mtime_ns": {
          "minimum": 0,
          "title": "Mtime Ns",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "source_fingerprint": {
          "title": "Source Fingerprint",
          "type": "string"
        },
        "config_digest": {
          "title": "Config Digest",
          "type": "string"
        },
        "tracker_digest": {
          "default": "",
          "title": "Tracker Digest",
          "type": "string"
        },
        "output_aspect": {
          "exclusiveMinimum": 0,
          "title": "Output Aspect",
          "type": "number"
        },
        "analysis_complete": {
          "title": "Analysis Complete",
          "type": "boolean"
        },
        "timeline_digest": {
          "title": "Timeline Digest",
          "type": "string"
        }
      },
      "required": [
        "plan_ref",
        "sha256",
        "size",
        "mtime_ns",
        "schema_version",
        "producer",
        "source_fingerprint",
        "config_digest",
        "output_aspect",
        "analysis_complete",
        "timeline_digest"
      ],
      "title": "FramingPlanIdentity",
      "type": "object"
    },
    "FramingRender": {
      "description": "Render geometry the normalized trajectory is valid for.",
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "aspect": {
          "exclusiveMinimum": 0,
          "title": "Aspect",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "aspect"
      ],
      "title": "FramingRender",
      "type": "object"
    },
    "FramingSceneTimeline": {
      "description": "Normalized Task 12 scene on the clip-relative clock (inclusive frames).",
      "properties": {
        "scene_id": {
          "minimum": 0,
          "title": "Scene Id",
          "type": "integer"
        },
        "strategy": {
          "minLength": 1,
          "title": "Strategy",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "applies": {
          "title": "Applies",
          "type": "boolean"
        },
        "scene_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Kind"
        },
        "subject_ids": {
          "items": {
            "type": "string"
          },
          "title": "Subject Ids",
          "type": "array"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/FramingKeyframe"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "fallback_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Detail"
        },
        "fit": {
          "default": false,
          "title": "Fit",
          "type": "boolean"
        }
      },
      "required": [
        "scene_id",
        "strategy",
        "start_frame",
        "end_frame",
        "applies"
      ],
      "title": "FramingSceneTimeline",
      "type": "object"
    },
    "FramingSource": {
      "description": "Source slice the plan was authored against (plan header).",
      "properties": {
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "slice_offset_frames": {
          "minimum": 0,
          "title": "Slice Offset Frames",
          "type": "integer"
        }
      },
      "required": [
        "fingerprint",
        "width",
        "height",
        "fps",
        "frame_count",
        "slice_offset_frames"
      ],
      "title": "FramingSource",
      "type": "object"
    },
    "Grade": {
      "properties": {
        "preset": {
          "default": "default",
          "title": "Preset",
          "type": "string"
        }
      },
      "title": "Grade",
      "type": "object"
    },
    "Overlay": {
      "description": "Text overlays: hooks, banners.",
      "properties": {
        "type": {
          "enum": [
            "hook",
            "banner"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "style": {
          "default": "viral",
          "title": "Style",
          "type": "string"
        },
        "start": {
          "description": "clip-relative seconds",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "position": {
          "default": "top",
          "title": "Position",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "start",
        "end"
      ],
      "title": "Overlay",
      "type": "object"
    },
    "ProjectFraming": {
      "description": "Task 13 bridge: the accepted automatic camera plan as project data.\n\n``eligible=True`` means the normalized trajectory is complete and may\nbe replayed/edited by a future trajectory tool. ``eligible=False``\nwith ``ineligibility_reason`` is an audit reference only (e.g. an\nincomplete Task 12 plan): it must never be treated as a camera path.",
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "eligible": {
          "default": true,
          "title": "Eligible",
          "type": "boolean"
        },
        "ineligibility_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ineligibility Reason"
        },
        "plan": {
          "$ref": "#/$defs/FramingPlanIdentity"
        },
        "source": {
          "$ref": "#/$defs/FramingSource"
        },
        "render": {
          "$ref": "#/$defs/FramingRender"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/FramingSceneTimeline"
          },
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "plan",
        "source",
        "render"
      ],
      "title": "ProjectFraming",
      "type": "object"
    },
    "ProjectSegment": {
      "description": "One timeline segment. v1: editor works single-segment; schema allows many.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "description": "source seconds, inclusive",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "description": "source seconds, exclusive",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "number"
        },
        "crop": {
          "$ref": "#/$defs/CropBox"
        },
        "transition_in": {
          "default": "cut",
          "enum": [
            "cut",
            "fade"
          ],
          "title": "Transition In",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "crop"
      ],
      "title": "ProjectSegment",
      "type": "object"
    },
    "ReframedBase": {
      "description": "Lineage for automatic framing preservation (Task 05).\n\nOptional. When present on an auto-emitted project, records the\noriginal reframed clip (with tracked-speaker/layout framing) plus\nthe geometry/timeline baseline and file identity needed to detect\nmissing, stale, or replaced assets.\n\nEligibility is semantic equivalence to the baseline; see\n``domain.project_lineage.check_lineage_eligible``.",
      "properties": {
        "base_ref": {
          "description": "job-relative path to the reframed base clip",
          "title": "Base Ref",
          "type": "string"
        },
        "identity": {
          "additionalProperties": true,
          "description": "file identity: file/size/mtime for staleness detection",
          "title": "Identity",
          "type": "object"
        },
        "source": {
          "additionalProperties": true,
          "description": "source baseline: file/width/height",
          "title": "Source",
          "type": "object"
        },
        "segments": {
          "description": "ordered segment geometry baseline",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Segments",
          "type": "array"
        },
        "render": {
          "additionalProperties": true,
          "description": "render geometry baseline: width/height/fps",
          "title": "Render",
          "type": "object"
        },
        "framing": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Task 13 framing baseline identity: plan_ref, sha256, source_fingerprint, config_digest, tracker_digest, output_aspect, analysis_complete, timeline_digest",
          "title": "Framing"
        }
      },
      "required": [
        "base_ref"
      ],
      "title": "ReframedBase",
      "type": "object"
    },
    "RenderSpec": {
      "properties": {
        "width": {
          "default": 608,
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "integer"
        },
        "encoder": {
          "default": "nvenc",
          "enum": [
            "nvenc",
            "libx264"
          ],
          "title": "Encoder",
          "type": "string"
        }
      },
      "title": "RenderSpec",
      "type": "object"
    },
    "SourceRef": {
      "properties": {
        "file": {
          "description": "16:9 source slice on disk, e.g. source_<clip>.mp4",
          "title": "File",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "duration": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source slice duration in seconds (informational)",
          "title": "Duration"
        }
      },
      "required": [
        "file",
        "width",
        "height"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "schema": {
      "const": "nugget.clip-project/1",
      "title": "Schema",
      "type": "string"
    },
    "version": {
      "default": 1,
      "description": "increments per save",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "origin": {
      "default": "auto",
      "enum": [
        "auto",
        "user",
        "legacy"
      ],
      "title": "Origin",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "clip_index": {
      "minimum": 0,
      "title": "Clip Index",
      "type": "integer"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/ProjectSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "captions": {
      "$ref": "#/$defs/Captions"
    },
    "overlays": {
      "items": {
        "$ref": "#/$defs/Overlay"
      },
      "title": "Overlays",
      "type": "array"
    },
    "audio": {
      "items": {
        "$ref": "#/$defs/AudioTrack"
      },
      "title": "Audio",
      "type": "array"
    },
    "grade": {
      "$ref": "#/$defs/Grade"
    },
    "render": {
      "$ref": "#/$defs/RenderSpec"
    },
    "base_clip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Clip"
    },
    "legacy_params": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Params"
    },
    "reframed_base": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReframedBase"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "framing": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectFraming"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "clip_index",
    "source",
    "segments"
  ],
  "title": "ClipProject",
  "type": "object"
}
